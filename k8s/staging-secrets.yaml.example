# Example Kubernetes secrets file
# Copy this file to k8s/staging-secrets.yaml and fill in your values
# DO NOT commit actual secrets to version control

apiVersion: v1
kind: Secret
metadata:
  name: hayy-api-staging-secrets
  namespace: hayy-staging
data:
  # Base64 encoded values - use: echo -n "your-value" | base64
  NODE_ENV: c3RhZ2luZw==  # staging
  MONGODB_URI: bW9uZ29kYitzcnY6Ly9VU0VSTkFNRTpQQVNTV09SRUBDTFVTVEVSLk1PTkdPRC5ORVQvREFUQUJBU0U=  # mongodb+srv://USERNAME:PASSWORD@CLUSTER.MONGODB.NET/DATABASE
  PORT: ODAwMA==  # 8000
type: Opaque
